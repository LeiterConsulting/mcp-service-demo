# Optional. Without a key, the app runs in deterministic guided-demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local service URLs used by the agent host.
SPLUNK_MCP_URL=http://127.0.0.1:8101/mcp
TICKET_MCP_URL=http://127.0.0.1:8102/mcp

# App ports. Change these if the defaults are occupied.
DEMO_WEB_PORT=8100
SPLUNK_MCP_PORT=8101
TICKET_MCP_PORT=8102

# Browser-saved Splunk settings override these environment defaults.
# "fixture" needs no external services; "live" searches a real Splunk endpoint.
SPLUNK_DATA_MODE=fixture

# Real Splunk management API (required when SPLUNK_DATA_MODE=live).
SPLUNK_REST_URL=https://127.0.0.1:8089
SPLUNK_REST_TOKEN=
SPLUNK_REST_TOKEN_SCHEME=Bearer
# Or use basic authentication instead of SPLUNK_REST_TOKEN:
SPLUNK_USERNAME=
SPLUNK_PASSWORD=

# HTTP Event Collector used by seed-splunk and live-mode Reset demo.
SPLUNK_HEC_URL=https://127.0.0.1:8088
SPLUNK_HEC_TOKEN=

# Companion app defaults. Keep these aligned if you customize the Splunk app.
SPLUNK_APP=mcp_service_demo
SPLUNK_OWNER=nobody
SPLUNK_INDEX=mcp_demo
SPLUNK_SOURCETYPE=mcp:demo:event
SPLUNK_SCENARIO_ID=checkout-degradation-v1

# Keep verification enabled. For a self-signed local lab only, set the relevant value to false.
SPLUNK_REST_VERIFY_SSL=true
SPLUNK_HEC_VERIFY_SSL=true
SPLUNK_SEARCH_TIMEOUT_SECONDS=60
SPLUNK_INDEX_WAIT_SECONDS=30
SPLUNK_HEC_BATCH_SIZE=200
# SPLUNK_REST_CA_BUNDLE=/absolute/path/to/ca.pem
# SPLUNK_HEC_CA_BUNDLE=/absolute/path/to/ca.pem
